pipeline {
    agent any

    parameters {
        string(
            name: 'USERNAME',
            defaultValue: 'Akash',
            description: 'Enter your name'
        )
    }

    stages {
        stage('Display User') {
            steps {
                echo "Hello, ${params.USERNAME}"
            }
        }
    }
}
pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['DEV', 'QA', 'PROD'],
            description: 'Select Environment'
        )
    }

    stages {
        stage('Deploy') {
            steps {
                echo "Deploying application to ${params.ENVIRONMENT}"
            }
        }
    }
}
